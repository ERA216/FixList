# Необязательно: без ключей ИИ приложение использует резервный режим.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Модель можно заменить на доступную вашему проекту Gemini.
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT=12
LLM_TOTAL_BUDGET=30
LLM_MAX_RETRIES=2

# Общий отправитель FixList через Resend. Настраивается один раз владельцем сервера.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# При использовании SMTP: получатель подключает почту в аккаунте FixList.
# Используйте пароль приложения Google, а не обычный пароль от почты.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
