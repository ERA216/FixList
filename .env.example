# Необязательно: без ключей ИИ приложение использует резервный режим.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Модель можно заменить на доступную вашему проекту Gemini.
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT=12
LLM_TOTAL_BUDGET=30
LLM_MAX_RETRIES=2

# Gmail-отправитель уведомлений. Получатель задаётся в Аккаунт → Уведомления о поломках.
# Используйте пароль приложения Google, а не обычный пароль от почты.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
